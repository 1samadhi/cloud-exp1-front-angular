# Plantilla: el contenedor de nginx sustituye las variables de entorno al
# arrancar (/docker-entrypoint.d/20-envsubst-on-templates.sh) y escribe el
# resultado en /etc/nginx/conf.d/default.conf.
#
# Con SECRETO_GATEWAY definido, solo se acepta la peticion que traiga ese valor
# en la cabecera. Con SECRETO_GATEWAY vacio la entrada del map pasa a ser la
# cadena vacia, que es justo lo que envia un cliente sin cabecera, de modo que
# la comprobacion queda desactivada y la imagen sirve para ejecutar en local.
map $http_x_origen_gateway $origen_valido {
    default              0;
    "${SECRETO_GATEWAY}" 1;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        # El API Gateway debe ser el unico punto de entrada. La instancia tiene
        # IP publica, asi que sin esto el frontend se serviria tambien por el
        # puerto 80 directo, saltandose el gateway y su autorizador.
        if ($origen_valido = 0) {
            return 403 '{"error":"Esta aplicacion solo se sirve a traves del API Gateway"}';
        }
        # Angular resuelve el enrutado en el navegador: cualquier ruta
        # desconocida devuelve index.html en lugar de 404, o recargar /catalogo
        # romperia la aplicacion.
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|woff2?|svg|png|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
