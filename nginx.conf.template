# El front ahora se sirve directo desde esta instancia, con su propia URL,
# separado del API Gateway que solo expone el backend. El navegador hace
# peticiones cross-origin reales hacia la API, por eso cada microservicio
# valida CORS de verdad (ver seguridad.origenes-cors).
#
# HTTPS es obligatorio aqui, no cosmetico: MSAL y oidc-client-ts generan el
# code_challenge de PKCE con crypto.subtle, que los navegadores desactivan
# fuera de un contexto seguro (HTTPS o localhost). Sin esto la app ni siquiera
# arranca. El Lab no tiene permiso para CloudFront/ACM, asi que el certificado
# es autofirmado: el navegador pide aceptarlo una vez.
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name _;
    ssl_certificate     /etc/nginx/certs/front.crt;
    ssl_certificate_key /etc/nginx/certs/front.key;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        # index.html nunca se cachea: es el que nombra el bundle vigente. Sin
        # esta cabecera el navegador aplica caducidad heuristica y puede seguir
        # sirviendo la version anterior durante horas despues de un despliegue.
        # Los bundles si se cachean, porque su nombre lleva un hash del
        # contenido y cambia en cada compilacion.
        add_header Cache-Control "no-cache, must-revalidate";

        # Angular resuelve el enrutado en el navegador: cualquier ruta
        # desconocida devuelve index.html en lugar de 404, o recargar /catalogo
        # romperia la aplicacion.
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|woff2?|svg|png|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
