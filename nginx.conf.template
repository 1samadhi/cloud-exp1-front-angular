# Plantilla: el contenedor de nginx sustituye las variables de entorno al
# arrancar (/docker-entrypoint.d/20-envsubst-on-templates.sh) y escribe el
# resultado en /etc/nginx/conf.d/default.conf.
map $http_x_origen_gateway $origen_valido {
    default            0;
    "${SECRETO_GATEWAY}" 1;
    ""                 0;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # El API Gateway debe ser el unico punto de entrada. La instancia tiene IP
    # publica, asi que sin esta comprobacion el frontend se serviria tambien por
    # el puerto 80 directo, saltandose el gateway. El gateway inyecta la
    # cabecera en sus integraciones; lo que llegue sin ella se rechaza.
    #
    # Si SECRETO_GATEWAY viene vacio la comprobacion se desactiva, que es lo
    # adecuado para ejecutar la imagen en local.
    set $exigir_gateway "${SECRETO_GATEWAY}";
    if ($exigir_gateway = "") {
        set $origen_valido 1;
    }

    location / {
        if ($origen_valido = 0) {
            return 403 '{"error":"Esta aplicacion solo se sirve a traves del API Gateway"}';
        }
        # Angular resuelve el enrutado en el navegador: cualquier ruta
        # desconocida devuelve index.html en lugar de 404, o recargar /catalogo
        # romperia la aplicacion.
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|woff2?|svg|png|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
